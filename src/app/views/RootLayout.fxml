<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane stylesheets="@../resources/styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.controllers.RootController">

    <bottom>
        <HBox alignment="CENTER"
              spacing="5"
              prefHeight="120"
              minHeight="120"
              maxHeight="120"
              style="-fx-padding: 15;">

            <Button onAction="#goPlayerProfile"
                    styleClass="people_button"
                    text="Dashboard"
                    prefWidth="96"
                    prefHeight="36" />

            <Button onAction="#goDashboard"
                    styleClass="history_button"
                    text="Add Match"
                    prefWidth="96"
                    prefHeight="36" />

            <Button onAction="#goAddMatch"
                    styleClass="new_match_button"
                    text="Player Profile"
                    prefWidth="32"
                    prefHeight="36" />

            <Button onAction="#goLeaderboards"
                    styleClass="leaderboard_button"
                    text="Leaderboards"
                    prefWidth="96"
                    prefHeight="36" />

            <Button onAction="#goSeasonView"
                    styleClass="graph_button"
                    text="Season View"
                    prefWidth="96"
                    prefHeight="36" />

        </HBox>
    </bottom>

    <center>
        <StackPane fx:id="contentArea" />
    </center>

</BorderPane>