<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.controllers.AddMatchController"
      spacing="10"
      style="-fx-padding: 20;">

    <Label text="Add Match"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <VBox spacing="5">
            <Label text="Player 1"/>
            <ComboBox fx:id="playerOneBox" prefWidth="200"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Player 2"/>
            <ComboBox fx:id="playerTwoBox" prefWidth="200"/>
        </VBox>
    </HBox>

    <Separator />

    <HBox spacing="10">

        <ComboBox fx:id="eventPlayerBox" prefWidth="150" />

        <ComboBox fx:id="eventTypeBox" prefWidth="150" />

        <TextField fx:id="timeField"
                   promptText="Time (seconds)"
                   prefWidth="120" />

        <TextField fx:id="goalSpeedField"
                   promptText="Goal Speed"
                   prefWidth="120" />

    </HBox>

    <HBox spacing="10">

        <CheckBox fx:id="shotScoredCheck"
                  text="Shot Scored" />

        <CheckBox fx:id="shotSavedCheck"
                  text="Shot Saved" />

        <CheckBox fx:id="epicSaveCheck"
                  text="Epic Save" />

    </HBox>

    <HBox spacing="10">

        <Button text="Add Event"
                onAction="#handleAddEvent" />

        <Button text="Save Match"
                onAction="#handleSaveMatch" />

    </HBox>

    <Label text="Events" style="-fx-font-size: 18px;" />

    <ListView fx:id="eventListView"
              VBox.vgrow="ALWAYS" />

</VBox>