<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.controllers.PlayerProfileController"
      spacing="10"
      style="-fx-padding: 20;">

    <Label text="Players"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <HBox spacing="10">

        <TextField fx:id="playerNameField"
                   promptText="Player Name"
                   prefWidth="250" />

        <Button text="Add Player"
                onAction="#handleAddPlayer" />
        <Button text="Refresh Players"
        onAction="#handleRefreshPlayers" />

    </HBox>

    <HBox spacing="10">

        <Button text="Edit Selected"
                onAction="#handleEditPlayer" />

        <Button text="Remove Selected"
                onAction="#handleRemovePlayer" />

    </HBox>

    <ListView fx:id="playerListView"
              VBox.vgrow="ALWAYS" />

</VBox>